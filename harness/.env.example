# OpenAI-compatible LLM API
# Copy this file to .env (same directory) and fill in your values.
# Use `set -a && source .env && set +a` before running the harness.

# Required: Your API key
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Custom API base URL for providers other than OpenAI
# OpenAI:      https://api.openai.com/v1 (default)
# DeepSeek:    https://api.deepseek.com/v1
# Anthropic:   https://api.anthropic.com/v1  (via OpenAI-compatible adapter)
# Local (vLLM): http://localhost:8000/v1
# Local (Ollama): http://localhost:11434/v1
# OPENAI_BASE_URL=

# Optional: Model override (can also pass via --model CLI arg)
# LLM_MODEL=gpt-4o-mini